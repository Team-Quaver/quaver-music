{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@quaver/sparkle": ["../vendor/Sparkle/sdk/index.ts"],
      "@quaver/sparkle/*": ["../vendor/Sparkle/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../vendor/Sparkle/sdk/**/*.ts", "../vendor/Sparkle/plugins/**/*.ts", "../vendor/Sparkle/market/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
