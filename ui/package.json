{
  "name": "red.0w0.quaver",
  "productName": "Quaver Music",
  "desktopName": "red.0w0.quaver.desktop",
  "description": "又一个第三方 QQ 音乐客户端",
  "author": "ne0w0r1d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/team-quaver/quaver-music.git"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "version": "1.2.0",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "pnpm run build && electron .",
    "verify:config": "node scripts/verify-config.mjs && node scripts/verify-prefs-map.mjs",
    "verify:input": "node scripts/verify-input-policy.mjs",
    "verify:song-menu": "node scripts/verify-song-menu.mjs",
    "verify:list-tools": "node scripts/verify-list-tools.mjs",
    "verify:queue-anim": "node scripts/verify-queue-panel-anim.mjs",
    "verify:queue-drag": "node scripts/verify-queue-drag.mjs",
    "verify:noselect": "node scripts/verify-noselect.mjs",
    "verify:user-vip": "node scripts/verify-user-vip.mjs",
    "verify:sidebar": "node scripts/verify-sidebar.mjs",
    "verify:playlist-menu": "node scripts/verify-playlist-menu.mjs",
    "verify:systheme": "node scripts/verify-systheme.mjs",
    "verify:login": "node scripts/verify-login.mjs",
    "verify:keyring": "node scripts/verify-keyring.mjs",
    "verify:daily": "node scripts/verify-daily.mjs",
    "verify:guess": "node scripts/verify-guess.mjs",
    "verify:sparkle": "node scripts/verify-sparkle.mjs",
    "verify:static": "node scripts/verify-config.mjs && node scripts/verify-prefs-map.mjs && node scripts/verify-highlight-contrast.mjs && node scripts/verify-song-menu.mjs && node scripts/verify-list-tools.mjs && node scripts/verify-queue-panel-anim.mjs && node scripts/verify-queue-drag.mjs && node scripts/verify-noselect.mjs && node scripts/verify-user-vip.mjs && node scripts/verify-sidebar.mjs && node scripts/verify-playlist-menu.mjs && node scripts/verify-systheme.mjs && node scripts/verify-login.mjs && node scripts/verify-keyring.mjs && node scripts/verify-daily.mjs && node scripts/verify-guess.mjs && node scripts/verify-sparkle.mjs && node scripts/verify-input-policy.mjs && node scripts/verify-streaminfo.mjs && node scripts/verify-hotkeys.mjs && node scripts/verify-shuffle.mjs && node scripts/verify-icon.mjs",
    "mpris:build": "pnpm --dir ../vendor/Typhoeus/mpris install && pnpm --dir ../vendor/Typhoeus/mpris run build",
    "dist": "pnpm run build && pnpm run mpris:build && electron-builder --linux AppImage",
    "verify:np-gallery": "node scripts/verify-np-gallery.mjs",
    "verify:streaminfo": "node scripts/verify-streaminfo.mjs",
    "verify:loved-sync": "node scripts/verify-loved-sync.mjs",
    "verify:songlist-sync": "node scripts/verify-songlist-sync.mjs",
    "verify:hotkeys": "node scripts/verify-hotkeys.mjs",
    "verify:shuffle": "node scripts/verify-shuffle.mjs",
    "verify:icon": "node scripts/verify-icon.mjs"
  },
  "build": {
    "appId": "red.0w0.quaver",
    "productName": "Quaver Music",
    "directories": {
      "output": "release"
    },
    "executableName": "quaver",
    "artifactName": "Quaver-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-bin",
        "to": "bin",
        "filter": ["quaver-server*"]
      },
      {
        "from": "../vendor/Typhoeus/mpris/dist/mpris-daemon.cjs",
        "to": "mpris/mpris-daemon.cjs"
      },
      {
        "from": "build-res/icon.png",
        "to": "build-res/icon.png"
      },
      {
        "from": "build-res/icons",
        "to": "build-res/icons"
      },
      {
        "from": "build-res/tray.png",
        "to": "build-res/tray.png"
      },
      {
        "from": "build-res/audio",
        "to": "audio",
        "filter": [
          "**/*",
          "!**/*.AppImage",
          "!**/.work/**"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "executableName": "red.0w0.quaver",
      "icon": "build-res/icons",
      "maintainer": "ne0w0r1d <ne0w0r1d@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-res/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build-res/icon.png",
      "identity": null
    }
  },
  "devDependencies": {
    "@applemusic-like-lyrics/core": "^0.6.0",
    "@applemusic-like-lyrics/lyric": "^1.1.0",
    "@types/node": "^22.20.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "dmg-license"
    ]
  }
}
