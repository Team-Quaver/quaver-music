{
  "name": "quaver-ui",
  "productName": "Quaver",
  "description": "又一个第三方 QQ 音乐客户端",
  "author": "ne0w0r1d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ne0W0r1d/quaver-music.git"
  },
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "verify:config": "node scripts/verify-config.mjs && node scripts/verify-prefs-map.mjs",
    "verify:song-menu": "node scripts/verify-song-menu.mjs",
    "verify:list-tools": "node scripts/verify-list-tools.mjs",
    "verify:queue-anim": "node scripts/verify-queue-panel-anim.mjs",
    "verify:queue-drag": "node scripts/verify-queue-drag.mjs",
    "verify:noselect": "node scripts/verify-noselect.mjs",
    "verify:user-vip": "node scripts/verify-user-vip.mjs",
    "verify:sidebar": "node scripts/verify-sidebar.mjs",
    "verify:systheme": "node scripts/verify-systheme.mjs",
    "verify:login": "node scripts/verify-login.mjs",
    "verify:daily": "node scripts/verify-daily.mjs",
    "verify:guess": "node scripts/verify-guess.mjs",
    "verify:static": "node scripts/verify-config.mjs && node scripts/verify-prefs-map.mjs && node scripts/verify-highlight-contrast.mjs && node scripts/verify-song-menu.mjs && node scripts/verify-list-tools.mjs && node scripts/verify-queue-panel-anim.mjs && node scripts/verify-queue-drag.mjs && node scripts/verify-noselect.mjs && node scripts/verify-user-vip.mjs && node scripts/verify-sidebar.mjs && node scripts/verify-systheme.mjs && node scripts/verify-login.mjs && node scripts/verify-daily.mjs && node scripts/verify-guess.mjs",
    "mpris:build": "npm --prefix ../vendor/Typhoeus/mpris install && npm --prefix ../vendor/Typhoeus/mpris run build",
    "dist": "npm run build && npm run mpris:build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "red.0w0.quaver",
    "productName": "Quaver Music",
    "directories": { "output": "release" },
    "executableName": "quaver",
    "artifactName": "Quaver-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-bin/quaver-server",
        "to": "bin/quaver-server"
      },
      {
        "from": "../vendor/Typhoeus/mpris/dist/mpris-daemon.cjs",
        "to": "mpris/mpris-daemon.cjs"
      },
      {
        "from": "build-res/icon.png",
        "to": "build-res/icon.png"
      },
      {
        "from": "build-res/tray.png",
        "to": "build-res/tray.png"
      },
      {
        "from": "build-res/audio",
        "to": "audio",
        "filter": ["**/*", "!**/*.AppImage", "!**/.work/**"]
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Audio",
      "icon": "build-res/icon.png",
      "maintainer": "ne0w0r1d <ne0w0r1d@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
